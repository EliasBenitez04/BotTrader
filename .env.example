APP_NAME=BotTrader
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL 9.5.25 compatible DSN.
DATABASE_URL=postgresql+psycopg2://bottrader:change_me@127.0.0.1:5432/bottrader

# Trading safety.
TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
LIVE_CONFIRMATION=
BOT_ADMIN_TOKEN=change-this-token

# Binance.
BINANCE_BASE_URL=https://api.binance.com
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision
BINANCE_USE_TESTNET=true
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_RECV_WINDOW_MS=5000
BINANCE_HTTP_TIMEOUT_SECONDS=15

# Universe / worker.
QUOTE_ASSET=USDT
SYMBOLS_CSV=BTCUSDT,ETHUSDT,SOLUSDT
DEFAULT_TIMEFRAME=5m
WORKER_INTERVAL_SECONDS=60
MARKET_LOOKBACK_CANDLES=500

# Strategy.
BUY_SCORE_THRESHOLD=75
SELL_SCORE_THRESHOLD=35
RSI_PERIOD=14
ATR_PERIOD=14

# Risk.
PAPER_INITIAL_CAPITAL=1000
RISK_PER_TRADE=0.01
MAX_DAILY_LOSS=0.03
MAX_DRAWDOWN=0.10
MAX_OPEN_POSITIONS=3
MAX_CONSECUTIVE_LOSSES=3
MAX_POSITION_QUOTE_FRACTION=0.25
STOP_LOSS_PCT=0.01
TAKE_PROFIT_R_MULTIPLE=2.0
TRADING_FEE_BPS=10
SLIPPAGE_BPS=5

# Backtesting.
MIN_BACKTEST_TRADES=100
